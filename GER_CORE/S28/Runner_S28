"""
=============================================================
run_all_s28.py
=============================================================

Executa automaticamente todos os experimentos da S28.

Lê:

    GER_RESULTS/S28_AUDIT/S28_inventory.csv

Executa apenas módulos marcados com:

    main == True
    ou
    __main__ == True

Resultados:

GER_RESULTS/
    S28_RUN_ALL/
        <timestamp>/
            summary.csv
            summary.json
            summary.txt
            <modulo>/
                stdout.txt
                stderr.txt
                metadata.json

=============================================================
"""

from __future__ import annotations

import csv
import json
import subprocess
import sys

from datetime import datetime
from pathlib import Path

# ==========================================================
# CONFIGURAÇÃO
# ==========================================================

ROOT = Path("/content/GER")

INVENTORY = (
    ROOT
    / "GER_RESULTS"
    / "S28_AUDIT"
    / "S28_inventory.csv"
)

TIMESTAMP = datetime.now().strftime("%Y%m%d_%H%M%S")

OUTPUT = (
    ROOT
    / "GER_RESULTS"
    / "S28_RUN_ALL"
    / TIMESTAMP
)

OUTPUT.mkdir(parents=True, exist_ok=True)

# ==========================================================
# AMBIENTE
# ==========================================================

import os

os.chdir(ROOT)

print("=" * 70)
print("RUN ALL S28")
print("=" * 70)
print(f"Working directory : {Path.cwd()}")
print()

# ==========================================================
# LEITURA DO INVENTÁRIO
# ==========================================================

modules = []

with INVENTORY.open(
    encoding="utf-8"
) as f:

    reader = csv.DictReader(f)

    for row in reader:

        if (
            row["main"] == "True"
            or row["__main__"] == "True"
        ):

            modules.append(row)

print(f"Modules detected : {len(modules)}")
print()

# ==========================================================
# EXECUÇÃO
# ==========================================================

summary = []

passed = 0
failed = 0

for item in modules:

    module = item["module"]

    module_name = module.replace(".", "_")

    folder = OUTPUT / module_name

    folder.mkdir(exist_ok=True)

    print(f">>> {module}")

    result = subprocess.run(

        [
            sys.executable,
            "-m",
            f"GER_CORE.S28.{module}",
        ],

        cwd=ROOT,

        capture_output=True,

        text=True,

    )

    (folder / "stdout.txt").write_text(
        result.stdout,
        encoding="utf-8",
    )

    (folder / "stderr.txt").write_text(
        result.stderr,
        encoding="utf-8",
    )

    metadata = {

        "module": module,
        "returncode": result.returncode,

    }

    (folder / "metadata.json").write_text(

        json.dumps(
            metadata,
            indent=4,
        ),

        encoding="utf-8",

    )

    status = (
        "PASS"
        if result.returncode == 0
        else "FAIL"
    )

    if status == "PASS":
        passed += 1
    else:
        failed += 1

    summary.append(

        {

            "module": module,
            "status": status,
            "returncode": result.returncode,

        }

    )

# ==========================================================
# SUMMARY CSV
# ==========================================================

with (OUTPUT / "summary.csv").open(

    "w",
    newline="",
    encoding="utf-8",

) as f:

    writer = csv.DictWriter(

        f,

        fieldnames=summary[0].keys(),

    )

    writer.writeheader()

    writer.writerows(summary)

# ==========================================================
# SUMMARY JSON
# ==========================================================

(OUTPUT / "summary.json").write_text(

    json.dumps(summary, indent=4),

    encoding="utf-8",

)

# ==========================================================
# SUMMARY TXT
# ==========================================================

with (OUTPUT / "summary.txt").open(

    "w",
    encoding="utf-8",

) as f:

    f.write("=" * 70 + "\n")
    f.write("RUN ALL S28\n")
    f.write("=" * 70 + "\n\n")

    f.write(f"Modules detected : {len(modules)}\n")
    f.write(f"PASS             : {passed}\n")
    f.write(f"FAIL             : {failed}\n")

# ==========================================================
# FINAL
# ==========================================================

print()
print("=" * 70)
print("EXECUTION FINISHED")
print("=" * 70)

print(f"Modules detected : {len(modules)}")
print(f"PASS             : {passed}")
print(f"FAIL             : {failed}")

print()
print("Results saved to:")
print(OUTPUT)
