"""
=============================================================
S28_FULL_AUDIT.py
=============================================================

Auditoria estrutural completa da série S28.

Produz:

GER_RESULTS/
    S28_AUDIT/
        S28_inventory.csv
        S28_inventory.json
        S28_inventory.txt

=============================================================
"""

from __future__ import annotations

import ast
import csv
import json
from pathlib import Path


# ==========================================================
# CONFIGURAÇÃO
# ==========================================================

ROOT = Path("GER_CORE/S28")

OUTPUT = Path("GER_RESULTS/S28_AUDIT")
OUTPUT.mkdir(parents=True, exist_ok=True)


# ==========================================================
# HELPERS
# ==========================================================

def has_main_function(tree):

    for node in tree.body:

        if isinstance(node, ast.FunctionDef):

            if node.name == "main":

                return True

    return False


def has_main_guard(tree):

    for node in tree.body:

        if not isinstance(node, ast.If):
            continue

        test = node.test

        if not isinstance(test, ast.Compare):
            continue

        if not isinstance(test.left, ast.Name):
            continue

        if test.left.id != "__name__":
            continue

        if len(test.comparators) != 1:
            continue

        value = test.comparators[0]

        if isinstance(value, ast.Constant):

            if value.value == "__main__":
                return True

    return False


def classify(tree):

    names = {
        n.name.lower()
        for n in tree.body
        if isinstance(
            n,
            (
                ast.FunctionDef,
                ast.AsyncFunctionDef,
                ast.ClassDef,
            ),
        )
    }

    if "main" in names:
        return "Experiment"

    if any(
        x.startswith("audit")
        or x.startswith("validate")
        or x.startswith("check")
        for x in names
    ):
        return "Audit"

    if len(tree.body) <= 2:
        return "Stub"

    return "Utility"


# ==========================================================
# AUDITORIA
# ==========================================================

rows = []

syntax_ok = 0
syntax_error = 0

for file in sorted(ROOT.rglob("*.py")):

    relative = file.relative_to(ROOT)

    try:

        source = file.read_text(encoding="utf-8")

        tree = ast.parse(source)

        syntax = "OK"

        syntax_ok += 1

        rows.append({

            "module": relative.with_suffix("").as_posix().replace("/", "."),

            "file": str(relative),

            "lines": len(source.splitlines()),

            "main": has_main_function(tree),

            "__main__": has_main_guard(tree),

            "classification": classify(tree),

            "syntax": syntax,

        })

    except Exception as exc:

        syntax_error += 1

        rows.append({

            "module": relative.with_suffix("").as_posix().replace("/", "."),

            "file": str(relative),

            "lines": 0,

            "main": False,

            "__main__": False,

            "classification": "ERROR",

            "syntax": str(exc),

        })


# ==========================================================
# CSV
# ==========================================================

csv_file = OUTPUT / "S28_inventory.csv"

with csv_file.open(
    "w",
    newline="",
    encoding="utf-8",
) as f:

    writer = csv.DictWriter(
        f,
        fieldnames=rows[0].keys(),
    )

    writer.writeheader()

    writer.writerows(rows)


# ==========================================================
# JSON
# ==========================================================

json.dump(

    rows,

    open(
        OUTPUT / "S28_inventory.json",
        "w",
        encoding="utf-8",
    ),

    indent=4,

)


# ==========================================================
# TXT
# ==========================================================

txt = OUTPUT / "S28_inventory.txt"

with txt.open("w", encoding="utf-8") as f:

    f.write("=" * 70 + "\n")
    f.write("S28 STRUCTURAL AUDIT\n")
    f.write("=" * 70 + "\n\n")

    f.write(f"Files               : {len(rows)}\n")
    f.write(f"Syntax OK           : {syntax_ok}\n")
    f.write(f"Syntax Errors       : {syntax_error}\n")
    f.write(f"main()              : {sum(r['main'] for r in rows)}\n")
    f.write(f"__main__            : {sum(r['__main__'] for r in rows)}\n")

    f.write("\n")

    classes = {}

    for r in rows:
        classes[r["classification"]] = (
            classes.get(r["classification"], 0) + 1
        )

    for k in sorted(classes):
        f.write(f"{k:<15}: {classes[k]}\n")


# ==========================================================
# CONSOLE
# ==========================================================

print("=" * 70)
print("S28 STRUCTURAL AUDIT")
print("=" * 70)

print(f"Files          : {len(rows)}")
print(f"Syntax OK      : {syntax_ok}")
print(f"Syntax Errors  : {syntax_error}")
print(f"main()         : {sum(r['main'] for r in rows)}")
print(f"__main__       : {sum(r['__main__'] for r in rows)}")

print("\nClassification")

classes = {}

for r in rows:
    classes[r["classification"]] = (
        classes.get(r["classification"], 0) + 1
    )

for k in sorted(classes):
    print(f"{k:<15}: {classes[k]}")

print("\nResults saved to:")
print(OUTPUT)
